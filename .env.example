# 复制为 .env 后修改；AUTH_SECRET 必须换成随机长字符串（>32 字符）
AUTH_SECRET=please-change-to-a-long-random-string-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@2026
CORS_ORIGINS=
DATABASE_URL=sqlite:///./data/aps.db
AUTO_SCHEDULE_ON_START=1
STARTUP_SOLVE_SECONDS=6
FREEZE_HORIZON_MINUTES=120
POSTGRES_PASSWORD=aps_dev_pass
